{
  "name": "piggpin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:all": "cd core && wasm-pack build --target web && cd .. && npm run build",
    "build:wasm": "cd core && wasm-pack build --target web",
    "build:wasm:spatial": "cd zig-core && zig build -Drelease=true && cp zig-out/bin/spatial.wasm pkg/spatial.wasm",
    "build:wasm:all": "npm run build:wasm && npm run build:wasm:spatial",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@meshtastic/core": "^2.6.7",
    "@meshtastic/protobufs": "^2.7.18",
    "@meshtastic/transport-web-bluetooth": "^0.1.5",
    "@meshtastic/transport-web-serial": "^0.2.5",
    "@tauri-apps/api": "^2.11.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.markercluster": "^1.5.3",
    "mp4box": "^2.3.0",
    "path-browserify": "^1.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  }
}
